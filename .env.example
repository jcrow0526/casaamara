# ==============================================================================
# CASA AMARA — CONFIGURACIÓN DE ECART PAY (casamaraestudio.com)
# ==============================================================================
# Copia este archivo a `.env` y coloca tus llaves reales de Ecart Pay
# obtenidas en: Panel Ecart Pay > Integraciones > API
# ==============================================================================

# Frontend (Vite): URL de tu endpoint backend/serverless que crea la orden en Ecart Pay
# Si se deja vacío, la tienda opera en modo "Sandbox Preview" interactivo.
VITE_ECART_API_ENDPOINT=/api/ecart-checkout

# Entorno de Ecart Pay: "sandbox" o "production"
ECART_ENV=sandbox

# Llaves de API de Ecart Pay (Solo en servidor / Vercel / Netlify / Node, NUNCA exponer Private Key en frontend)
ECART_PUBLIC_KEY=tu_public_key_de_ecartpay
ECART_PRIVATE_KEY=tu_private_key_de_ecartpay

# URLs de retorno y webhook para casamaraestudio.com
ECART_REDIRECT_URL=https://casamaraestudio.com/checkout/confirmacion
ECART_NOTIFY_URL=https://casamaraestudio.com/api/ecart-webhook

# Contacto WhatsApp Hermosillo (formato internacional sin +)
VITE_WHATSAPP_NUMBER=526624284304
